# Salin menjadi .env lalu isi. JANGAN commit file .env.
#   cp .env.example .env

# Domain API (arahkan DNS A record ke IP VPS, lewat Cloudflare proxy/oranye).
DOMAIN=api.gkjwkarangpilang.org

# Database — buat password acak:  openssl rand -base64 32
POSTGRES_DB=gkjw
POSTGRES_USER=gkjw
POSTGRES_PASSWORD=

# Kunci penandatangan token login admin — buat dengan:  openssl rand -hex 32
JWT_SECRET=
# Masa berlaku login admin (format Go duration, mis. 168h = 7 hari).
JWT_TTL=168h

# Origin website yang boleh memanggil API dari browser (pisahkan koma).
# Kosongkan bila hanya dipakai aplikasi mobile.
CORS_ALLOWED_ORIGINS=https://gkjwkarangpilang.org

# Lama menyimpan backup harian di VPS (hari).
BACKUP_KEEP_DAYS=14
