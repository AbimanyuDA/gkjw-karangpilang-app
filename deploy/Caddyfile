# Caddy: HTTPS otomatis (Let's Encrypt) + reverse proxy ke API.
{
	servers {
		# Domain diproksikan Cloudflare: ambil IP asli jemaat dari CF-Connecting-IP,
		# tapi HANYA bila request memang datang dari IP Cloudflare.
		# Daftar terbaru: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Batas body: PDF maks 30 MB (+ overhead multipart).
	request_body {
		max_size 31MB
	}

	reverse_proxy api:8080 {
		# API hanya mempercayai header ini (bukan X-Forwarded-For dari klien).
		header_up X-Real-IP {client_ip}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
